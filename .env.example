# Canonical production origin. Set this in Vercel when using a custom domain.
# Vercel's production URL is used automatically when this is omitted.
# NEXT_PUBLIC_SITE_URL=https://your-festival-domain.example

# Optional Google Search Console HTML verification token.
# GOOGLE_SITE_VERIFICATION=your-verification-token

# Optional Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional external contact delivery endpoint. If omitted, the Supabase table migration is used.
# CONTACT_FORM_WEBHOOK_URL=https://your-email-provider.example/webhook
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact form delivery. Set the recipient address and an email provider webhook.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# CONTACT_FORM_WEBHOOK_URL=https://your-email-provider.example/webhook

# Supabase Dashboard → Project Settings → API. Use the publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
